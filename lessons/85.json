 "title": "-go verbs in commands: salga, póngalo; informal shortcut drops -go (ten, ven, sal, dime)",
 "cards": [
  {
   "title": "Formal / plural commands: -ga",
   "body": "With positive commands, lo goes after the verb; with negative ones, before.",
   "examples": [
    {
     "en": "Leave! / Don't leave! (you all)",
     "es": "¡Salgan! / ¡No salgan!"
    },
    {
     "en": "Put it here. (formal)",
     "es": "Póngalo aquí."
    },
    {
     "en": "Don't put it here. (formal)",
     "es": "No lo ponga aquí."
    }
   ],
   "t": 0
  },
  {
   "title": "Informal shortcut: drop the -go",
   "body": "Regular verbs drop the s (come, encuéntralo). The -go verbs drop -go: tengo → ten, vengo → ven, salgo → sal, digo → di.",
   "examples": [
    {
     "en": "Have it! (informal / formal)",
     "es": "¡Tenlo! / ¡Téngalo!"
    },
    {
     "en": "Come! (informal)",
     "es": "¡Ven!"
    },
    {
     "en": "Leave! (informal)",
     "es": "¡Sal!"
    }
   ],
   "t": 93.0
  },
  {
   "title": "venga vs ven",
   "body": "Venga ('come on', in Spain) has lost its formal feel as a fixed expression; ven means 'come here'.",
   "t": 171.3
  },
  {
   "title": "dígame / dime",
   "body": "Both are used to answer the phone. After a future cuando, use the mood tense.",
   "examples": [
    {
     "en": "Tell me (formal / informal)",
     "es": "Dígame / Dime"
    },
    {
     "en": "Tell me when you come.",
     "es": "Dime cuando vengas."
    },
    {
     "en": "Tell me when you do it. (formal)",
     "es": "Dígame cuando lo haga."
    }
   ],
   "t": 210.6
  }
 ],
