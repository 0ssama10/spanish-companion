 "title": "esperemos, que + mood (let him…), cuando + future → mood tense, vaya",
 "cards": [
  {
   "title": "Let's: esperemos",
   "body": "Esperemos is 'let's wait' (an order); ¿esperamos? is more like 'shall we wait?'.",
   "examples": [
    {
     "en": "Wait! (informal)",
     "es": "¡Espera!"
    },
    {
     "en": "Let's wait. / Let's not wait.",
     "es": "Esperemos. / No esperemos."
    }
   ],
   "t": 0
  },
  {
   "title": "que + mood = let him / let it …",
   "body": "",
   "examples": [
    {
     "en": "Let him wait.",
     "es": "Que espere."
    },
    {
     "en": "Let it finish already!",
     "es": "¡Que termine ya!"
    },
    {
     "en": "Let him be quiet.",
     "es": "Que se calle."
    }
   ],
   "t": 65.8
  },
  {
   "title": "cuando + future → mood tense",
   "body": "When cuando refers to something that hasn't happened yet, Spanish uses the mood tense, as if uneasy about stating the future as fact. Generally / habitually: normal present.",
   "examples": [
    {
     "en": "When we speak (generally)",
     "es": "cuando hablamos"
    },
    {
     "en": "When we speak (in the future)",
     "es": "cuando hablemos"
    }
   ],
   "t": 159.2
  },
  {
   "title": "comemos vs comamos",
   "body": "The other half can stay in the plain present: cuando gives the future context.",
   "examples": [
    {
     "en": "When we eat together, we talk (generally).",
     "es": "Cuando comemos juntos, hablamos."
    },
    {
     "en": "When we eat together, we'll talk.",
     "es": "Cuando comamos juntos, hablamos."
    }
   ],
   "t": 246.3
  },
  {
   "title": "ir → vaya",
   "body": "Mood tense of ir: vaya, vayan, vayamos.",
   "examples": [
    {
     "en": "We see her when we go (generally).",
     "es": "La vemos cuando vamos."
    },
    {
     "en": "We'll see her when we go.",
     "es": "La vemos cuando vayamos."
    }
   ],
   "t": 396.1
  }
 ],
