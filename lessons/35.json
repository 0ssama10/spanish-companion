 "title": "sincero, 'being' = estar siendo, -ing only for right now",
 "cards": [
  {
   "title": "sincero — guessing from -idad",
   "body": "From sinceridad you can guess sincero. Spanish decides ser vs estar by the concept, not the situation: sincerity is a characteristic, so ser.",
   "examples": [
    {
     "en": "I'm sincere.",
     "es": "Soy sincero. / Soy sincera."
    },
    {
     "en": "We're sincere.",
     "es": "Somos sinceros."
    }
   ],
   "t": 0
  },
  {
   "title": "estoy siendo = I'm being",
   "body": "To say you're being sincere right now, use estar + siendo (from ser, like vendiendo).",
   "examples": [
    {
     "en": "I'm being sincere.",
     "es": "Estoy siendo sincero. / Estoy siendo sincera."
    },
    {
     "en": "We're being honest.",
     "es": "Estamos siendo honestos."
    }
   ],
   "t": 112.2
  },
  {
   "title": "salgo pronto vs estoy saliendo",
   "body": "Only 'right now' takes the -ing form. Watch out for negative transfer from English, which puts -ing everywhere.",
   "examples": [
    {
     "en": "I'm leaving soon / tomorrow.",
     "es": "Salgo pronto. / Salgo mañana."
    },
    {
     "en": "I'm leaving (right now).",
     "es": "Estoy saliendo."
    }
   ],
   "t": 200.7
  },
  {
   "title": "Buying: now vs next week",
   "body": "",
   "examples": [
    {
     "en": "I'm buying them tomorrow.",
     "es": "Los compro mañana."
    },
    {
     "en": "I'm buying them next week.",
     "es": "Los compro la semana que viene."
    },
    {
     "en": "I'm buying them now.",
     "es": "Estoy comprándolos ahora. / Los estoy comprando ahora."
    }
   ],
   "t": 263.2
  }
 ],
