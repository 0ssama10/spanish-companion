 "title": "The uses of se, and se me … = 'on me' (se me quemó la cena)",
 "cards": [
  {
   "title": "Recap: sé and se",
   "body": "Sé (with accent) = I know (lo sé). Se without an accent = -self (se queda) or the replacement for le before lo (se lo preparo).",
   "examples": [
    {
     "en": "He stays.",
     "es": "Se queda."
    },
    {
     "en": "I prepare it for them.",
     "es": "Se lo preparo."
    }
   ],
   "t": 0
  },
  {
   "title": "se me … = '… on me'",
   "body": "Like English 'it died on me', but much more common in Spanish and possible with many verbs: se + me / te / le / nos / les.",
   "examples": [
    {
     "en": "The door closes (by itself).",
     "es": "La puerta se cierra."
    },
    {
     "en": "The door closes on me.",
     "es": "Se me cierra la puerta."
    }
   ],
   "t": 103.4
  },
  {
   "title": "se me quema la cena",
   "body": "You don't need to produce this yet; just recognise it when you hear it.",
   "examples": [
    {
     "en": "The dinner is burning.",
     "es": "La cena se quema."
    },
    {
     "en": "The dinner is burning on me.",
     "es": "La cena se me quema."
    }
   ],
   "t": 189.9
  },
  {
   "title": "acabar = to finish / run out",
   "body": "",
   "examples": [
    {
     "en": "The battery runs out.",
     "es": "La batería se acaba."
    },
    {
     "en": "My battery always runs out on me.",
     "es": "La batería siempre se me acaba."
    },
    {
     "en": "Does your battery run out? (informal / formal / all)",
     "es": "¿Se te acaba? / ¿Se le acaba? / ¿Se les acaba?"
    }
   ],
   "t": 270.7
  },
  {
   "title": "In the past",
