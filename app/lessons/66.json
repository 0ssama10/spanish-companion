 "title": "Body parts without 'my' (me duele la pierna), dolor de cabeza, la casa de José, solo",
 "cards": [
  {
   "title": "Fewer possessives than English",
   "body": "Spanish doesn't say 'my leg hurts' but 'it hurts me the leg'. Doler = to hurt, and the o splits: duele.",
   "examples": [
    {
     "en": "It hurts (me).",
     "es": "Me duele."
    },
    {
     "en": "My leg hurts.",
     "es": "Me duele la pierna."
    },
    {
     "en": "My leg doesn't hurt anymore.",
     "es": "No me duele la pierna más."
    }
   ],
   "t": 0
  },
  {
   "title": "dolor de cabeza = headache",
   "body": "'Pain of head.'",
   "examples": [
    {
     "en": "I have a headache.",
     "es": "Tengo dolor de cabeza. / Me duele la cabeza."
    },
    {
     "en": "I had a headache.",
     "es": "Tenía dolor de cabeza. / Me dolía la cabeza."
    }
   ],
   "t": 116.1
  },
  {
   "title": "José's house = la casa de José",
   "body": "",
   "examples": [
    {
     "en": "We're going to José's house.",
     "es": "Vamos a la casa de José."
    },
    {
     "en": "We're going to María's party.",
     "es": "Vamos a la fiesta de María."
    }
   ],
   "t": 164.1
  },
  {
   "title": "solo = only / just",
   "body": "Solo usually goes before the verb; at the end it sounds more emphatic.",
   "examples": [
    {
     "en": "I didn't talk to anyone else at María's party; I only talked to you.",
     "es": "No hablé con nadie más en la fiesta de María, solo hablé contigo."
    }
   ],
   "t": 220.5
  }
